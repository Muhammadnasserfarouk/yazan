rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // Each person's own small profile: which family they belong to.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      // Only members can read the family (baby info, members).
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Create a new family with yourself as the only member.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      // Members can edit the family. Anyone who knows the code can add ONLY themselves.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && resource.data.members.size() < 6
        )
      );
      allow delete: if false;

      // Sleeps, meds and doses: members only.
      match /{sub}/{id} {
        allow read, write: if sub in ['sleeps', 'meds', 'doses'] && isMember(fid);
      }
    }
  }
}
